# ============================================
# CompileX Environment Variables
# Copy this file to .env and fill in values
# ============================================

# App
APP_NAME=CompileX
DEBUG=True

# ── Database ──────────────────────────────
# Option 1: Local SQLite (default for dev)
DATABASE_URL=sqlite+aiosqlite:///./CompileX.db

# Option 2: Supabase PostgreSQL (recommended for production)
# Get from: supabase.com → Project → Settings → Database → URI
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# On IPv4-only hosts (e.g. Render free) use the pooler URI instead (host *.pooler.supabase.com);
# SSL and the pgbouncer settings are applied automatically.
# Copy existing SQLite data over once, before switching:
#   python migrate_sqlite_to_postgres.py --sqlite ./CompileX.db --postgres "<the URL above>"

# Option 3: Local Docker PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/compilex

# ── Security ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────
# Local dev: leave empty (allows all)
# Production: set to your Vercel URL
ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ── AI Service ────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_BACKEND=ai_service

# ── Explainer videos (landing page "Learn More") ────────────
# Drives the repo's videogen/ CLI as a child process. Needs an Anthropic key
# for the lesson design, plus an interpreter with manim, manim-voiceover and
# ffmpeg available:
#   python -m venv videogen/.venv
#   videogen/.venv/Scripts/pip install -r videogen/requirements.txt
# Leave VIDEOGEN_PYTHON empty to use the API server's own interpreter.
ANTHROPIC_API_KEY=
VIDEOGEN_PYTHON=
# VIDEOGEN_PYTHON=E:/CompileX/videogen/.venv/Scripts/python.exe
VIDEOGEN_DIR=
VIDEOGEN_QUALITY=m
VIDEOGEN_FPS=30
VIDEOGEN_MINUTES=4
VIDEOGEN_EFFORT=high
VIDEOGEN_RATE_LIMIT_PER_HOUR=3

# ── Email (for password reset) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CompileX

# ── Supabase (optional extras) ────────────
# Get from: supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Docker ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=compilex
