# Settings for `docker-compose up`. Copy this file to `.env` (never commit `.env`) and fill in the values.
# Use letters and digits only in passwords: they are placed inside URLs.

POSTGRES_USER=compilex
POSTGRES_PASSWORD=
POSTGRES_DB=compilex

# Needed: the shared state (lobbies, limits) lives here, and Redis refuses connections without it
REDIS_PASSWORD=

# Shared secret between the backend and the judge that runs players' code (letters and digits, at least 16)
JUDGE_TOKEN=

# Signs login tokens; any long random string
SECRET_KEY=

# Optional AI features (leave empty to run without them)
NVIDIA_API_KEY=
COMPLEXITY_NVIDIA_API_KEY=

# DEBUG=False is the default; set True only on your own machine
# DEBUG=True
