# Copy to `.env` on the judge machine (never commit `.env`).

# The secret the backend must send with every request. Letters and digits only, at least 16. Make one with:  openssl rand -hex 24
JUDGE_TOKEN=

# The machine's address with dashes, plus .sslip.io, which points back at the machine's IP and lets Caddy get a free certificate.
# Example: the IP 203.0.113.5 becomes 203-0-113-5.sslip.io
JUDGE_DOMAIN=

# How many programs may run at once. 4 suits a machine with 2 CPUs and 4 GB of memory (each sandbox may use up to 256 MB).
MAX_CONCURRENT_EXECUTIONS=4
